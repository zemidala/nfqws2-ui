#!/bin/sh
# nfqws-ui-setup — настройка веб-сервера для nfqws2-ui: порт, HTTPS, вход, задания cron.
# https://github.com/zemidala/nfqws2-ui
#
# Настройки хранятся в /etc/nfqws-ui/web.json, по ним собирается
# /etc/lighttpd/conf.d/90-nfqws-ui.conf. Перед перезапуском lighttpd конфиг проверяется
# (lighttpd -tt); если проверка не прошла, прежний файл возвращается на место.
# На Keenetic (Entware) всё то же лежит под /opt.

VERSION=1.10.1

# Система: OpenWrt — корень «/», Keenetic (Entware) — «/opt»
if [ ! -f /etc/openwrt_release ] && [ -x /opt/bin/opkg ]; then
	R=/opt
	WWW=/opt/share/www/nfqws-ui
	LEGACY_WWW=/opt/share/www/nfqws
	PHP=/opt/bin/php-cgi
	SBIN=/opt/sbin
	JOB_PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
	PATH=$JOB_PATH
	export PATH
	TLS_PKG=lighttpd-mod-openssl
	CERT_PKG=openssl-util
	# cron в Entware читает /opt/etc/cron.d: наши задания — отдельный файл
	CRONTAB=${NFQWS_UI_CRONTAB:-/opt/etc/cron.d/nfqws-ui}
else
	R=
	WWW=/www/nfqws-ui
	LEGACY_WWW=/www/nfqws
	PHP=/usr/bin/php-cgi
	SBIN=/usr/sbin
	JOB_PATH=/usr/sbin:/usr/bin:/sbin:/bin
	TLS_PKG=lighttpd-mod-mbedtls
	CERT_PKG=px5g-mbedtls
	CRONTAB=${NFQWS_UI_CRONTAB:-/etc/crontabs/root}
fi

CONF_DIR=${NFQWS_UI_CONF_DIR:-$R/etc/nfqws-ui}
WEB_JSON=$CONF_DIR/web.json
LDIR=${NFQWS_UI_LIGHTTPD:-$R/etc/lighttpd}
LCONF=$LDIR/conf.d/90-nfqws-ui.conf
LMAIN=$LDIR/lighttpd.conf
LEGACY_CONF=$LDIR/conf.d/80-nfqws.conf
MARK='# generated by nfqws-ui-setup'
CRT=$CONF_DIR/https.crt
KEY=$CONF_DIR/https.key

DEF_PORT=8090
DEF_HTTPS_PORT=8443
DEF_LEGACY_PORT=91

say() { printf '%s\n' "$*"; }
die() { printf 'Ошибка: %s\n' "$*" >&2; exit 1; }
# В режиме проверки (NFQWS_UI_TEST=1) службы не трогаются
svc() {
	[ -n "$NFQWS_UI_TEST" ] && return 0
	if [ -z "$R" ]; then /etc/init.d/"$@"; return; fi
	# В Entware службы — файлы S??имя, включать и выключать их не нужно
	case "$2" in enable | disable) return 0 ;; esac
	name=$1; shift
	for f in /opt/etc/init.d/S[0-9][0-9]"$name"; do
		[ -x "$f" ] && { "$f" "$@"; return; }
	done
	return 1
}

# ---------- настройки ----------

# web.json пишет save(): по ключу на строку, значения — числа, true/false и null.
# jsonfilter есть только на OpenWrt, поэтому разбираем сами
jget() { sed -n "s/^[[:space:]]*\"$1\": *\([^,]*\),\{0,1\}\$/\1/p" "$WEB_JSON" 2>/dev/null | sed 's/^null$//' | head -n1; }

load() {
	PORT=$DEF_PORT HTTPS_PORT= LEGACY_PORT= AUTH=true TAKEOVER=false CRON=true MANAGED=true
	if [ -f "$WEB_JSON" ]; then
		PORT=$(jget port); HTTPS_PORT=$(jget https_port); LEGACY_PORT=$(jget legacy_port)
		AUTH=$(jget auth); TAKEOVER=$(jget takeover); CRON=$(jget cron); MANAGED=$(jget managed)
		[ -n "$PORT" ] || PORT=$DEF_PORT
		[ "$AUTH" = false ] || AUTH=true
		[ "$TAKEOVER" = true ] || TAKEOVER=false
		[ "$CRON" = false ] || CRON=true
		[ "$MANAGED" = false ] || MANAGED=true
	fi
	# Файл lighttpd написан вручную — не трогаем его, порты берём из него
	if [ -f "$LCONF" ] && ! grep -q "^$MARK" "$LCONF"; then
		MANAGED=false
		detect_ports
	fi
}

jnum() { [ -n "$1" ] && printf '%s' "$1" || printf 'null'; }

save() {
	mkdir -p "$CONF_DIR"
	cat > "$WEB_JSON.tmp" <<-EOF
	{
	  "port": $(jnum "$PORT"),
	  "https_port": $(jnum "$HTTPS_PORT"),
	  "legacy_port": $(jnum "$LEGACY_PORT"),
	  "auth": $AUTH,
	  "takeover": $TAKEOVER,
	  "cron": $CRON,
	  "managed": $MANAGED
	}
	EOF
	mv "$WEB_JSON.tmp" "$WEB_JSON"
	chmod 600 "$WEB_JSON"
}

# Порты из написанного вручную 90-nfqws-ui.conf: блок с ssl.engine — HTTPS,
# блок с /nfqws/ — старый интерфейс, остальные — наш.
detect_ports() {
	PORT= HTTPS_PORT= LEGACY_PORT=
	eval "$(awk '
		/\$SERVER\["socket"\] *== *":[0-9]+"/ { match($0, /:[0-9]+/); p = substr($0, RSTART + 1, RLENGTH - 1); ssl = 0; old = 0; next }
		p && /ssl\.engine/ { ssl = 1 }
		p && /"\/nfqws\// { old = 1 }
		p && /^}/ { if (ssl) print "HTTPS_PORT=" p; else if (old) print "LEGACY_PORT=" p; else if (!port) { print "PORT=" p; port = p }; p = "" }
	' "$LCONF")"
	[ -n "$PORT" ] || PORT=$HTTPS_PORT
	[ "$PORT" = 90 ] && [ -n "$LEGACY_PORT" ] && TAKEOVER=true
	return 0
}

# ---------- проверки окружения ----------

legacy_ui() { [ -f "$LEGACY_CONF" ] && [ -d "$LEGACY_WWW" ]; }

# Задаёт ли кто-то кроме нас основной порт lighttpd (например, nfqws-keenetic-web — 8088)
foreign_main_port() {
	for f in $LDIR/conf.d/*.conf; do
		[ "$f" = "$LCONF" ] && continue
		grep -qE '^[[:space:]]*server\.port[[:space:]]*:?=' "$f" 2>/dev/null && return 0
	done
	grep -qE '^[[:space:]]*server\.port[[:space:]]*=' "$LMAIN" 2>/dev/null
}

port_busy() {
	# Порт занят не нашим lighttpd?
	netstat -ltnp 2>/dev/null | awk -v p=":$1" '$4 ~ p"$" { print $7 }' | grep -qv lighttpd
}

check_port() {
	case "$1" in '' | *[!0-9]*) die "порт должен быть числом: $1" ;; esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ] || die "порт вне диапазона 1–65535: $1"
	port_busy "$1" && die "порт $1 уже занят другой программой (netstat -ltnp)"
	return 0
}

tls_module() {
	[ -f $R/usr/lib/lighttpd/mod_mbedtls.so ] || [ -f $R/usr/lib/lighttpd/mod_openssl.so ] || [ -f $R/usr/lib/lighttpd/mod_wolfssl.so ] ||
		[ -f $R/lib/lighttpd/mod_mbedtls.so ] || [ -f $R/lib/lighttpd/mod_openssl.so ]
}

pkg_install() {
	if [ -z "$R" ] && command -v apk >/dev/null 2>&1; then
		apk update >/dev/null && apk add "$@"
	else
		opkg update >/dev/null && opkg install "$@"
	fi
}

need_managed() {
	[ "$MANAGED" = true ] && return 0
	say "Файл $LCONF написан вручную, nfqws-ui-setup его не меняет."
	say "Чтобы отдать его под управление nfqws-ui-setup (старый будет сохранён рядом), выполните:"
	say "  nfqws-ui-setup adopt"
	exit 1
}

# ---------- конфиг lighttpd ----------

php_block() { # $1 — https (1) или нет
	cat <<-EOF
	    cgi.assign += ( ".php" => "$PHP" )
	    static-file.exclude-extensions += ( ".php" )
	EOF
	if [ "$1" = 1 ]; then
		say "    setenv.set-environment = ( \"PATH\" => \"$JOB_PATH\", \"HTTPS\" => \"on\" )"
	else
		say "    setenv.set-environment = ( \"PATH\" => \"$JOB_PATH\" )"
	fi
	cat <<-EOF
	    index-file.names = ( "index.html" )
	    server.error-handler-404 = "/nfqws-ui/index.html"
	    url.rewrite-once = ( "^/(.*)" => "/nfqws-ui/\$1" )
	EOF
}

generate() {
	say "$MARK"
	say "# Не редактируйте вручную: файл пересобирается командой nfqws-ui-setup."
	say "# Настройки — $WEB_JSON, справка — nfqws-ui-setup help."
	say ""
	if [ "$TAKEOVER" = true ]; then
		say "# Порт 90 забран у nfqws-keenetic-web. Значения из 80-nfqws.conf для :90 переопределены"
		say "# оператором := (обычное = дало бы ошибку «Duplicate config variable»)."
		cat <<-EOF
		\$SERVER["socket"] == ":90" {
		    index-file.names := ( "index.html" )
		    server.error-handler-404 := "/nfqws-ui/index.html"
		    url.rewrite-once := ( "^/(.*)" => "/nfqws-ui/\$1" )
		}

		# Старый интерфейс nfqws-keenetic-web
		\$SERVER["socket"] == ":$LEGACY_PORT" {
		    cgi.assign += ( ".php" => "$PHP" )
		    static-file.exclude-extensions += ( ".php" )
		    setenv.set-environment = ( "PATH" => "$JOB_PATH" )
		    index-file.names = ( "index.html" )
		    server.error-handler-404 = "/nfqws/index.html"
		    url.rewrite-once = ( "^/(.*)" => "/nfqws/\$1" )
		}
		EOF
	else
		if ! foreign_main_port; then
			# lighttpd больше никто не настраивает: без этого он займёт порт 80 (там интерфейс роутера)
			say "server.port := $PORT"
			say "server.username := \"\""
			say "server.groupname := \"\""
			say ""
		fi
		say "\$SERVER[\"socket\"] == \":$PORT\" {"
		php_block 0
		say "}"
	fi
	if [ -n "$HTTPS_PORT" ]; then
		say ""
		say "\$SERVER[\"socket\"] == \":$HTTPS_PORT\" {"
		say "    ssl.engine = \"enable\""
		say "    ssl.pemfile = \"$CRT\""
		say "    ssl.privkey = \"$KEY\""
		php_block 1
		say "}"
	fi
}

restart_lighttpd() {
	svc lighttpd enable 2>/dev/null
	svc lighttpd restart >/dev/null 2>&1
	sleep 1
	[ -n "$NFQWS_UI_TEST" ] || pidof lighttpd >/dev/null || die "lighttpd не запустился, проверьте конфиг: lighttpd -tt -f $LMAIN"
}

apply_web() {
	need_managed
	mkdir -p "$CONF_DIR"
	old=
	if [ -f "$LCONF" ]; then
		old=/tmp/nfqws-ui-lighttpd.conf.prev
		cp -p "$LCONF" "$old"
	fi
	generate > "$LCONF.tmp" && mv "$LCONF.tmp" "$LCONF"
	if ! out=$(lighttpd -tt -f "$LMAIN" 2>&1); then
		if [ -n "$old" ]; then mv "$old" "$LCONF"; else rm -f "$LCONF"; fi
		say "$out" >&2
		die "lighttpd отклонил новый конфиг, прежний возвращён"
	fi
	rm -f "$old"
	restart_lighttpd
}

# ---------- cron ----------

cron_apply() {
	if [ -n "$R" ]; then
		# Формат cron.d: перед командой — пользователь
		if [ "$CRON" = true ]; then
			mkdir -p "${CRONTAB%/*}"
			cat > "$CRONTAB" <<-EOF
			$MARK
			PATH=$JOB_PATH
			*/10 * * * * root NFQWS_UI_CLI=scan $PHP -q -f $WWW/api.php >/dev/null 2>&1
			5 4 * * * root NFQWS_UI_CLI=daily $PHP -q -f $WWW/api.php >/dev/null 2>&1
			EOF
			chmod 600 "$CRONTAB"
		else
			rm -f "$CRONTAB"
		fi
		svc cron restart >/dev/null 2>&1
		return 0
	fi
	touch "$CRONTAB"
	sed -i '/NFQWS_UI_CLI=.*nfqws-ui\/api\.php/d' "$CRONTAB"
	if [ "$CRON" = true ]; then
		cat >> "$CRONTAB" <<-EOF
		*/10 * * * * NFQWS_UI_CLI=scan $PHP -q -f $WWW/api.php >/dev/null 2>&1
		5 4 * * * NFQWS_UI_CLI=daily $PHP -q -f $WWW/api.php >/dev/null 2>&1
		EOF
	fi
	svc cron enable 2>/dev/null
	svc cron restart >/dev/null 2>&1
}

# ---------- HTTPS ----------

https_on() {
	port=${1:-${HTTPS_PORT:-$DEF_HTTPS_PORT}}
	[ "$port" = "$HTTPS_PORT" ] || check_port "$port"
	if ! tls_module; then
		say "Для HTTPS нужен модуль $TLS_PKG, устанавливаю…"
		pkg_install $TLS_PKG || die "не удалось установить $TLS_PKG"
	fi
	if [ -n "$CERT_FILE" ]; then
		[ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] || die "нужны оба файла: --cert и --key"
		cp "$CERT_FILE" "$CRT" && cp "$KEY_FILE" "$KEY"
	elif [ ! -s "$CRT" ] || [ ! -s "$KEY" ]; then
		command -v px5g >/dev/null 2>&1 || command -v openssl >/dev/null 2>&1 || pkg_install $CERT_PKG || die "нечем выпустить сертификат: установите $CERT_PKG"
		cn=$(uci -q get system.@system[0].hostname 2>/dev/null || hostname 2>/dev/null || echo router)
		say "Выпускаю самоподписанный сертификат для $cn…"
		if command -v px5g >/dev/null 2>&1; then
			px5g selfsigned -days 3650 -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
				-keyout "$KEY" -out "$CRT" -subj "/CN=$cn/O=nfqws2-ui" >/dev/null 2>&1
		else
			openssl req -x509 -nodes -days 3650 -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
				-keyout "$KEY" -out "$CRT" -subj "/CN=$cn/O=nfqws2-ui" >/dev/null 2>&1
		fi
		[ -s "$CRT" ] || die "не удалось выпустить сертификат"
	fi
	chmod 600 "$KEY"
	HTTPS_PORT=$port
}

# ---------- команды ----------

lan_ip() {
	if [ -z "$R" ]; then
		uci -q get network.lan.ipaddr | cut -d/ -f1
	else
		# br0 — домашняя сеть Keenetic
		ip -f inet addr show dev br0 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n1
	fi
}

urls() {
	ip=$(lan_ip); [ -n "$ip" ] || ip=192.168.1.1
	[ -n "$PORT" ] && say "  http://$ip:$PORT"
	[ -n "$HTTPS_PORT" ] && say "  https://$ip:$HTTPS_PORT"
	[ -n "$LEGACY_PORT" ] && say "  http://$ip:$LEGACY_PORT  (старый интерфейс nfqws-keenetic-web)"
	return 0
}

status() {
	say "nfqws2-ui $VERSION"
	say "Адреса:"
	urls
	say "Вход по паролю root: $([ "$AUTH" = true ] && echo включён || echo ВЫКЛЮЧЕН)"
	say "Задания cron:        $([ "$CRON" = true ] && echo включены || echo выключены)"
	if [ "$MANAGED" = true ]; then
		say "Конфиг lighttpd:     $LCONF (собирается nfqws-ui-setup)"
	else
		say "Конфиг lighttpd:     $LCONF (написан вручную, не меняется)"
	fi
	legacy_ui && say "nfqws-keenetic-web:  установлен$([ "$TAKEOVER" = true ] && echo ', порт 90 отдан nfqws2-ui')"
	pidof lighttpd >/dev/null && say "lighttpd:            работает" || say "lighttpd:            НЕ РАБОТАЕТ"
}

# ---------- обновление ----------

REPO=zemidala/nfqws2-ui

fetch() { # url [файл]
	if command -v wget >/dev/null 2>&1; then
		wget -q -T 20 -O "${2:--}" "$1"
	else
		curl -fsSL -m 20 -o "${2:--}" "$1"
	fi
}

latest_version() {
	fetch "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null |
		sed -n 's/.*"tag_name" *: *"v\{0,1\}\([^"]*\)".*/\1/p' | head -n1
}

# $1 новее $2 (версии вида 1.2.3)
ver_gt() {
	awk -v a="$1" -v b="$2" 'BEGIN {
		split(a, x, "."); split(b, y, ".")
		for (i = 1; i <= 3; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 }
		exit 1
	}'
}

update() {
	check= force= want=
	for a; do
		case "$a" in
		--check | -c) check=1 ;;
		--force | -f) force=1 ;;
		v[0-9]* | [0-9]*) want=${a#v} ;;
		*) die "неизвестный параметр: $a (nfqws-ui-setup update [--check] [--force] [vX.Y.Z])" ;;
		esac
	done
	say "Установлено: $VERSION"
	if [ -z "$want" ]; then
		want=$(latest_version)
		[ -n "$want" ] || die "не удалось узнать последнюю версию: нет доступа к api.github.com или у репозитория нет публичных релизов"
		say "Последняя:   $want"
		# интерфейс хранит свой ответ GitHub — помечаем его устаревшим, чтобы он перепроверил и показал то же, что консоль
		[ -f "$CONF_DIR/update.json" ] && sed -i 's/"checked":[0-9]*/"checked":0/' "$CONF_DIR/update.json" 2>/dev/null
		if ! ver_gt "$want" "$VERSION" && [ -z "$force" ]; then
			say "Обновление не нужно."
			return 0
		fi
	fi
	if [ -n "$check" ]; then
		say "Доступно обновление до $want. Обновить: nfqws-ui-setup update"
		return 0
	fi
	[ "$want" = "$VERSION" ] && [ -z "$force" ] && { say "Версия $want уже установлена (--force — поставить заново)."; return 0; }
	say "Обновляю до $want…"
	tmp=/tmp/nfqws-ui-update.$$.sh
	fetch "https://github.com/$REPO/releases/download/v$want/install.sh" "$tmp" || { rm -f "$tmp"; die "не удалось скачать установщик v$want"; }
	# Если нас запустил lighttpd (кнопка в интерфейсе), выходим из его cgroup: при перезапуске
	# lighttpd procd может убить её целиком, а с ней и opkg посреди установки.
	# На Keenetic cgroup нет — без проверки shell сам пишет «can't create», и 2>/dev/null это не глушит.
	[ -w /sys/fs/cgroup/cgroup.procs ] && echo $$ > /sys/fs/cgroup/cgroup.procs 2>/dev/null
	NFQWS_UI_FORCE=$force sh "$tmp" "v$want"
	rc=$?
	rm -f "$tmp"
	[ $rc = 0 ] && say "Готово: nfqws2-ui $want."
	return $rc
}

usage() {
	cat <<-EOF
	nfqws-ui-setup $VERSION — настройка веб-сервера для nfqws2-ui

	  nfqws-ui-setup status               адреса и текущие настройки
	  nfqws-ui-setup port N               перенести интерфейс на порт N (по умолчанию $DEF_PORT)
	  nfqws-ui-setup https on [N]         включить HTTPS на порту N (по умолчанию $DEF_HTTPS_PORT),
	      [--cert FILE --key FILE]        свой сертификат вместо самоподписанного
	  nfqws-ui-setup https off            выключить HTTPS
	  nfqws-ui-setup takeover on|off      занять порт 90 вместо nfqws-keenetic-web (старый — на $DEF_LEGACY_PORT)
	  nfqws-ui-setup auth on|off          вход по паролю root (выключать не рекомендуется)
	  nfqws-ui-setup cron on|off          фоновые задания: мониторинг, история, ежедневный снимок
	  nfqws-ui-setup update               обновить до последней версии с GitHub
	      [--check]                       только проверить, есть ли обновление
	      [vX.Y.Z] [--force]              поставить конкретную версию / переустановить
	  nfqws-ui-setup version              установленная версия
	  nfqws-ui-setup apply                пересобрать конфиг lighttpd и cron из настроек
	  nfqws-ui-setup adopt                взять под управление написанный вручную конфиг lighttpd
	  nfqws-ui-setup remove               убрать конфиг lighttpd и задания cron (данные остаются)
	  nfqws-ui-setup uninstall            удалить интерфейс, установленный без пакета
	EOF
}

onoff() {
	case "$1" in on) echo true ;; off) echo false ;; *) die "нужно on или off" ;; esac
}

[ "$(id -u)" = 0 ] || die "запускайте от root"
load
cmd=$1
[ $# -gt 0 ] && shift

case "$cmd" in
status | '')
	status
	;;
port)
	need_managed
	[ "$TAKEOVER" = true ] && die "сейчас интерфейс на порту 90 (takeover on); сначала nfqws-ui-setup takeover off"
	[ "$1" = "$PORT" ] || check_port "$1"
	PORT=$1
	apply_web; save
	say "Готово. Интерфейс:"; urls
	;;
https)
	need_managed
	CERT_FILE= KEY_FILE= port=
	onoff "$1" >/dev/null; mode=$1; shift
	while [ $# -gt 0 ]; do
		case "$1" in
		--cert) CERT_FILE=$2; shift 2 ;;
		--key) KEY_FILE=$2; shift 2 ;;
		*) port=$1; shift ;;
		esac
	done
	if [ "$mode" = on ]; then https_on "$port"; else HTTPS_PORT=; fi
	apply_web; save
	say "Готово. Интерфейс:"; urls
	[ "$mode" = on ] && [ -z "$CERT_FILE" ] && say "Сертификат самоподписанный: браузер предупредит один раз, это ожидаемо."
	;;
takeover)
	need_managed
	v=$(onoff "$1")
	if [ "$v" = true ]; then
		legacy_ui || die "nfqws-keenetic-web не установлен — порт 90 никто не занимает, используйте nfqws-ui-setup port 90"
		LEGACY_PORT=${2:-$DEF_LEGACY_PORT}
		check_port "$LEGACY_PORT"
		TAKEOVER=true PORT=90
	else
		TAKEOVER=false LEGACY_PORT= PORT=$DEF_PORT
		check_port "$PORT"
	fi
	apply_web; save
	say "Готово. Интерфейс:"; urls
	;;
auth)
	AUTH=$(onoff "$1")
	save
	if [ "$AUTH" = false ]; then
		say "ВНИМАНИЕ: вход без пароля. Любой, кто откроет адрес интерфейса, сможет менять"
		say "настройки nfqws2 и запускать команды от root. Включить обратно: nfqws-ui-setup auth on"
	else
		say "Вход по паролю root включён."
	fi
	;;
cron)
	CRON=$(onoff "$1")
	cron_apply; save
	say "Задания cron $([ "$CRON" = true ] && echo включены || echo выключены)."
	;;
apply)
	if [ ! -f "$WEB_JSON" ] && [ "$MANAGED" = true ]; then
		# Первая установка: если порт по умолчанию занят, берём следующий свободный
		while port_busy "$PORT" && [ "$PORT" -lt $((DEF_PORT + 20)) ]; do PORT=$((PORT + 1)); done
		port_busy "$PORT" && die "не нашёл свободный порт в $DEF_PORT–$PORT, задайте свой: nfqws-ui-setup port N"
	fi
	[ "$MANAGED" = true ] && apply_web
	cron_apply; save
	status
	;;
adopt)
	if [ "$MANAGED" = false ]; then
		bak="$LCONF.bak-$(date +%Y%m%d-%H%M%S)"
		mv "$LCONF" "$bak"
		say "Прежний конфиг сохранён: $bak"
		MANAGED=true
		[ "$PORT" = 90 ] && [ -n "$LEGACY_PORT" ] && TAKEOVER=true
		[ -n "$HTTPS_PORT" ] && [ ! -s "$CRT" ] && say "Для HTTPS будет выпущен самоподписанный сертификат (свой: nfqws-ui-setup https on $HTTPS_PORT --cert … --key …)." && https_on "$HTTPS_PORT"
	fi
	apply_web; save
	status
	;;
remove)
	if [ "$MANAGED" = true ] && [ -f "$LCONF" ]; then
		standalone=
		grep -q '^server\.port :=' "$LCONF" && standalone=1
		rm -f "$LCONF"
		if [ -n "$standalone" ]; then
			# lighttpd работал только для nfqws2-ui: без нашего порта он полез бы на 80 (интерфейс роутера)
			svc lighttpd stop >/dev/null 2>&1
			svc lighttpd disable 2>/dev/null
		elif pidof lighttpd >/dev/null; then
			svc lighttpd restart >/dev/null 2>&1
		fi
	fi
	CRON=false
	cron_apply
	;;
uninstall)
	# Для установки без пакета (OpenWrt с apk); пакет удаляется через opkg remove nfqws2-ui
	if [ ! -f "$CONF_DIR/.manual" ] && command -v opkg >/dev/null 2>&1 && opkg status nfqws2-ui 2>/dev/null | grep -q '^Status:.*installed'; then
		die "интерфейс установлен пакетом, удаляйте так: opkg remove nfqws2-ui"
	fi
	"$0" remove
	rm -rf "$WWW" /tmp/nfqws-ui-cache /tmp/nfqws-ui-test /tmp/nfqws-ui-pending.json /tmp/nfqws-ui-login.json
	rm -f "$CONF_DIR/.manual" $SBIN/nfqws-ui-setup $SBIN/nfqws-ui
	say "nfqws2-ui удалён. Настройки, снимки и история остались в $CONF_DIR, $R/etc/nfqws2/.snapshots, $R/etc/nfqws2/.history"
	;;
update | upgrade)
	update "$@"
	;;
version | -v | --version)
	say "$VERSION"
	;;
help | -h | --help)
	usage
	;;
*)
	usage
	exit 1
	;;
esac
