#!/bin/sh
[ "$1" = upgrade ] && exit 0
rm -f /tmp/nfqws-ui-pending.json /tmp/nfqws-ui-login.json
rm -rf /tmp/nfqws-ui-cache /tmp/nfqws-ui-test /tmp/nfqws-ui-sess
# opkg оставляет пустые каталоги пакета
for d in docs lib js/pages js css/looks css; do rmdir "/opt/share/www/nfqws-ui/$d" 2>/dev/null; done
rmdir /opt/share/www/nfqws-ui 2>/dev/null
echo "nfqws2-ui удалён. Настройки, снимки и история остались в /opt/etc/nfqws-ui, /opt/etc/nfqws2/.snapshots, /opt/etc/nfqws2/.history"
exit 0
